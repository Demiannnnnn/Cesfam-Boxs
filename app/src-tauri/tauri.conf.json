{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestion de Boxes",
  "mainBinaryName": "gestion-box-app",
  "version": "0.1.0",
  "identifier": "cl.cesfam.gestionbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gestión de Boxes",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "category": "Productivity",
    "shortDescription": "Reserva de boxes de atención del CESFAM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "es-ES" }
    }
  }
}
